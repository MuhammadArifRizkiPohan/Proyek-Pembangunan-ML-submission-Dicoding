        "import re\n",
        "def get_id(url):\n",
        "    m=re.search(r\"(?:v=|youtu\\.be/)([A-Za-z0-9_-]{11})\",url)\n",
        "    return m.group(1) if m else None\n",
        "\n",
        "print(get_id(\"https://www.youtube.com/watch?v=nb_fFj_0rq8\"))\n"
      ],
