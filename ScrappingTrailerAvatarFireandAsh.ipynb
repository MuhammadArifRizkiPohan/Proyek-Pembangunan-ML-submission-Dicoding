      "source": [
        "!pip install google-api-python-client pandas\n",
        "\n",
        "from googleapiclient.discovery import build\n",
        "import pandas as pd\n",
        "\n",
        "api_key = \"AIzaSyCUaBZz6ymgeGi0HaONbVrLkaJV33xg4wg\"\n",
        "video_id = \"nb_fFj_0rq8\"\n",
        "\n",
        "youtube = build('youtube', 'v3', developerKey=api_key)\n",
        "\n",
        "comments = []\n",
        "\n",
        "def get_comments(youtube, video_id, token=None):\n",
        "    response = youtube.commentThreads().list(\n",
        "        part='snippet,replies',\n",
        "        videoId=video_id,\n",
        "        maxResults=100,\n",
        "        pageToken=token\n",
        "    ).execute()\n",
        "\n",
        "    for item in response.get('items', []):\n",
        "        top_comment = item['snippet']['topLevelComment']['snippet']\n",
        "        comments.append(top_comment['textDisplay'])\n",
        "        # Ambil reply kalau ada\n",
        "        if 'replies' in item:\n",
        "            for reply in item['replies']['comments']:\n",
        "                comments.append(reply['snippet']['textDisplay'])\n",
        "    return response.get('nextPageToken')\n",
        "\n",
        "token = None\n",
        "while True:\n",
        "    token = get_comments(youtube, video_id, token)\n",
        "    if not token or len(comments) >= 13000:\n",
        "        break\n",
        "\n",
        "df = pd.DataFrame(comments, columns=['text'])\n",
        "df.to_csv('avatar_comments_trailer1_full.csv', index=False, encoding='utf-8')\n",
        "\n"
      ]
